def entry_type_for_signal(prev_candle, candle, bias: str, fast: float, slow: float, cfg: Dict[str, float]) -> Optional[str]:
    if prev_candle is None:
        return None

    confirmed = breakout_confirmed(prev_candle, candle, bias)
    slack = cfg["early_breakout_slack"]

    if bias == "LONG":
        early_breakout = candle.close >= prev_candle.high * (1.0 - slack)
        ema_ready = fast >= slow
    else:
        early_breakout = candle.close <= prev_candle.low * (1.0 + slack)
        ema_ready = fast <= slow

    if confirmed and ema_ready:
        return "CONFIRMED"
    if early_breakout and ema_ready:
        return "EARLY"
    return None


def confidence_score(info: dict, candle, fast: float, slow: float, entry_type: str) -> float:
    price = max(candle.close, 1e-9)
    ema_gap = abs(fast - slow) / price
    body = candle_body_ratio(candle)
    move_strength = min(abs(info["pct"]) / 1.8, 1.0)
    vol_strength = min(math.log1p(max(info["vol"], 1.0)) / 16.0, 1.0)
    ema_strength = min(ema_gap / 0.003, 1.0)

    base = (
        0.30 * move_strength +
        0.20 * vol_strength +
        0.25 * ema_strength +
        0.25 * body
    )

    if entry_type == "CONFIRMED":
        base += 0.10

    return min(base, 1.0)


