def chunks(lst, n):
    for i in range(0, len(lst), n):
        yield lst[i:i + n]


def fetch_ltp_v3(token: str, keys: list[str]) -> dict:
    url = "https://api.upstox.com/v3/market-quote/ltp"
    r = requests.get(
        url,
        headers={"Accept": "application/json", "Authorization": f"Bearer {token}"},
        params={"instrument_key": ",".join(keys)},
        timeout=30,
    )
    r.raise_for_status()
    return r.json().get("data", {})


def token_to_symbol(instrument_token: str) -> Optional[str]:
    return instrument_token.split(":", 1)[1].strip() if ":" in instrument_token else None


def ms_to_dt_local(ms: int) -> datetime:
    return datetime.fromtimestamp(ms / 1000, tz=timezone.utc).astimezone()


def symbol_in_cooldown(symbol: str, cooldown_until: Dict[str, datetime]) -> bool:
    until = cooldown_until.get(symbol)
    return bool(until and now_ist() < until)


def breakout_confirmed(prev_candle, candle, bias: str) -> bool:
    if prev_candle is None:
        return False
    if bias == "LONG":
        return candle.close > prev_candle.high
    return candle.close < prev_candle.low


def candle_body_ratio(candle) -> float:
    rng = max(candle.high - candle.low, 1e-9)
    body = abs(candle.close - candle.open)
    return body / rng


def is_strong_entry_candle(prev_candle, candle, bias: str, min_body_ratio: float) -> bool:
    if prev_candle is None:
        return False
    if candle_body_ratio(candle) < min_body_ratio:
        return False
    if bias == "LONG":
        return candle.close > candle.open and candle.close > prev_candle.high
    return candle.close < candle.open and candle.close < prev_candle.low


def breakout_chase_pct(prev_candle, candle, bias: str) -> float:
    if prev_candle is None:
        return 0.0
    if bias == "LONG":
        if candle.close <= prev_candle.high:
            return 0.0
        return (candle.close - prev_candle.high) / max(prev_candle.high, 1e-9)

    if candle.close >= prev_candle.low:
        return 0.0
    return (prev_candle.low - candle.close) / max(prev_candle.low, 1e-9)


def too_close_to_recent_extreme(info: dict, candle, bias: str, pct_threshold: float) -> bool:
    if pct_threshold <= 0:
        return False

    recent_highs = info.get("recent_highs", [])
    recent_lows = info.get("recent_lows", [])

    if bias == "LONG":
        if not recent_highs:
            return False
        recent_high = max(recent_highs)
        dist_to_high_pct = (recent_high - candle.close) / max(candle.close, 1e-9)
        return dist_to_high_pct < pct_threshold

    if not recent_lows:
        return False
    recent_low = min(recent_lows)
    dist_to_low_pct = (candle.close - recent_low) / max(candle.close, 1e-9)
    return dist_to_low_pct < pct_threshold


def get_market_snapshot(token: str) -> Dict[str, Any]:
    try:
        data = fetch_ltp_v3(token, [INDEX_KEY])
        if not data:
            return {"trend": "NEUTRAL", "regime": "CHOPPY", "pct": 0.0}

        _, payload = next(iter(data.items()))
        ltp = float(payload.get("last_price") or 0.0)
        cp = float(payload.get("cp") or 0.0)

        if ltp <= 0 or cp <= 0:
            return {"trend": "NEUTRAL", "regime": "CHOPPY", "pct": 0.0}

        pct = (ltp - cp) / cp

        if pct >= MARKET_TREND_THRESHOLD:
            trend = "BULLISH"
        elif pct <= -MARKET_TREND_THRESHOLD:
            trend = "BEARISH"
        else:
            trend = "NEUTRAL"

        ap = abs(pct)
        if ap >= TRENDING_REGIME_PCT:
            regime = "TRENDING"
        elif ap <= CHOPPY_REGIME_PCT:
            regime = "CHOPPY"
        else:
            regime = "NORMAL"

        return {"trend": trend, "regime": regime, "pct": pct}
    except Exception:
        return {"trend": "NEUTRAL", "regime": "CHOPPY", "pct": 0.0}


