def entry_type_for_signal(prev_candle, candle, bias: str, fast: float, slow: float, cfg: Dict[str, float]) -> Optional[str]:
    if prev_candle is None:
        return None

    confirmed = breakout_confirmed(prev_candle, candle, bias)
    slack = cfg["early_breakout_slack"]

    if bias == "LONG":
        early_breakout = candle.close >= prev_candle.high * (1.0 - slack)
        ema_ready = fast >= slow
    else:
        early_breakout = candle.close <= prev_candle.low * (1.0 + slack)
        ema_ready = fast <= slow

    if confirmed and ema_ready:
        return "CONFIRMED"
    if early_breakout and ema_ready:
        return "EARLY"
    return None


def confidence_score(info: dict, candle, fast: float, slow: float, entry_type: str) -> float:
    price = max(candle.close, 1e-9)
    ema_gap = abs(fast - slow) / price
    body = candle_body_ratio(candle)
    move_strength = min(abs(info["pct"]) / 1.8, 1.0)
    vol_strength = min(math.log1p(max(info["vol"], 1.0)) / 16.0, 1.0)
    ema_strength = min(ema_gap / 0.003, 1.0)

    base = 0.30 * move_strength + 0.20 * vol_strength + 0.25 * ema_strength + 0.25 * body

    if entry_type == "CONFIRMED":
        base += 0.10

    return min(base, 1.0)


def size_multiplier(confidence: float, regime: str) -> float:
    if regime == "CHOPPY":
        if confidence >= 0.80:
            return 1.00
        if confidence >= 0.65:
            return 0.85
        return 0.60

    if confidence >= 0.85:
        return 1.35
    if confidence >= 0.70:
        return 1.15
    if confidence >= 0.55:
        return 1.00
    return 0.75


def pick_top_candidates_bi_directional(
    token: str,
    sym_to_key: Dict[str, str],
    cooldown_until: Dict[str, datetime],
    market_trend: str,
    cfg: Dict[str, float],
    top_k: int = TOP_K_MONITOR,
) -> List[Tuple[float, str, str, str, float, int, float, float]]:
    candidates = []

    print("🔍 Running fresh scan...")
    print(f"🌍 Market trend filter: {market_trend}")

    min_abs_move_pct = cfg["min_abs_move_pct"]
    max_abs_move_pct = cfg["max_abs_move_pct"]
    long_min_abs_move_pct = cfg["long_min_abs_move_pct"]
    short_min_abs_move_pct = cfg["short_min_abs_move_pct"]

    for batch in chunks(list(sym_to_key.values()), BATCH_SIZE):
        data = fetch_ltp_v3(token, batch)

        for inst_token, v in data.items():
            sym = token_to_symbol(inst_token)
            if not sym:
                continue
            if symbol_in_cooldown(sym, cooldown_until):
                continue

            inst_key = sym_to_key.get(sym)
            if not inst_key:
                continue

            ltp = float(v.get("last_price") or 0.0)
            cp = float(v.get("cp") or 0.0)
            vol = float(v.get("volume") or 0.0)

            if ltp <= 0 or cp <= 0:
                continue
            if ltp < MIN_LTP or ltp > MAX_LTP:
                continue
            if vol < MIN_VOLUME:
                continue

            pct = (ltp - cp) / cp * 100.0
            ap = abs(pct)

            if ap < min_abs_move_pct or ap > max_abs_move_pct:
                continue

            max_shares = int(CAPITAL_PER_TRADE // ltp)
            if max_shares < MIN_AFFORDABLE_SHARES:
                continue

            bias = "LONG" if pct > 0 else "SHORT"

            if bias == "LONG" and market_trend == "BEARISH":
                continue
            if bias == "SHORT" and market_trend == "BULLISH":
                continue

            if bias == "LONG" and ap < long_min_abs_move_pct:
                continue

            if bias == "SHORT":
                if ap < short_min_abs_move_pct:
                    continue
                if pct <= SHORT_SKIP_IF_TOO_EXTENDED_PCT:
                    continue

            score = ap * 6.0 + math.log1p(vol)
            candidates.append((score, sym, inst_key, bias, ltp, max_shares, pct, vol))

    if not candidates:
        return []

    candidates.sort(reverse=True, key=lambda x: x[0])
    top = candidates[:top_k]

    print(f"✅ Top monitored candidates (Top-{top_k}):")
    for idx, (score, sym, inst_key, bias, ltp, max_shares, pct, vol) in enumerate(top, start=1):
        print(
            f"   {idx}. {sym} | bias={bias} | key={inst_key} | "
            f"LTP={ltp:.2f} | %={pct:.2f} | vol={int(vol)} | "
            f"max_shares={max_shares} | score={score:.2f}"
        )

    return top


def get_authorized_ws_url(token: str) -> str:
    r = requests.get(
        "https://api.upstox.com/v3/feed/market-data-feed/authorize",
        headers={"Authorization": f"Bearer {token}", "Accept": "application/json"},
        timeout=30,
    )
    r.raise_for_status()
    return r.json()["data"]["authorized_redirect_uri"]


def make_sub_msg(instrument_keys: List[str]) -> bytes:
    return json.dumps(
        {
            "guid": uuid.uuid4().hex,
            "method": "sub",
            "data": {"mode": "ltpc", "instrumentKeys": instrument_keys},
        }
    ).encode("utf-8")


def record_exit_and_print(closed_pos, risk, reporter):
    pnl = closed_pos.pnl()
    risk.record_trade_closed(trading_day(), pnl)

    print(
        f"✅ EXIT ({closed_pos.side}) {closed_pos.symbol} @ {closed_pos.exit_price:.2f}  "
        f"PnL={pnl:.2f}  dailyPnL={risk.state.realized_pnl:.2f}"
    )

    reporter.record_exit(
        closed_pos.symbol,
        closed_pos.side,
        closed_pos.qty,
        float(closed_pos.exit_price),
        float(pnl),
        str(closed_pos.exit_reason or "RULE_EXIT"),
    )


def run_topk_session(token: str, candidates, risk, broker, reporter, market_trend: str, regime: str, cfg: Dict[str, float]) -> dict:
    session_result = {
        "trade_opened": False,
        "trade_closed": False,
        "stop_requested": False,
        "session_reason": "",
        "closed_symbols": [],
    }

    by_key = {}
    for score, sym, inst_key, bias, ltp, max_shares, pct, vol in candidates:
        by_key[inst_key] = {
            "symbol": sym,
            "bias": bias,
            "score": score,
            "ltp": ltp,
            "max_shares": max_shares,
            "pct": pct,
            "vol": vol,
            "builder": CandleBuilder(timeframe_minutes=TIMEFRAME_MINUTES),
            "strat": EMACrossoverStrategy(fast=9, slow=21),
            "focus_candle_count": 0,
            "disabled": False,
            "prev_candle": None,
            "recent_low": None,
            "recent_highs": [],
            "recent_lows": [],
        }

    session_start_ist = now_ist()
    retries = 0
    instrument_keys = list(by_key.keys())
    last_ltp_by_symbol: Dict[str, float] = {}

    while retries < WS_MAX_RETRIES_PER_SESSION:
        if market_stopped():
            session_result["stop_requested"] = True
            session_result["session_reason"] = "MARKET_CLOSE"
            return session_result

        if no_new_entries_now() and broker.open_count() == 0:
            session_result["session_reason"] = "ENTRY_CUTOFF"
            return session_result

        ws_url = get_authorized_ws_url(token)

        def on_open(ws):
            print("✅ WebSocket connected")
            ws.send(make_sub_msg(instrument_keys), opcode=websocket.ABNF.OPCODE_BINARY)
            print("📨 subscribed:", ", ".join(instrument_keys))
            reporter.info("subscribed_topk", {"symbols": [by_key[k]["symbol"] for k in instrument_keys]})

        def on_message(ws, message):
            if not isinstance(message, (bytes, bytearray)):
                return

            resp = MarketDataFeed_pb2.FeedResponse()
            resp.ParseFromString(message)
            if resp.type not in (MarketDataFeed_pb2.initial_feed, MarketDataFeed_pb2.live_feed):
                return

            if broker.open_count() == 0:
                if (now_ist() - session_start_ist).total_seconds() >= RESCAN_INTERVAL_MIN * 60:
                    print(f"🔁 Periodic rescan reached ({RESCAN_INTERVAL_MIN} min). Returning to scan mode.")
                    session_result["session_reason"] = "PERIODIC_RESCAN"
                    ws.close()
                    return

            if broker.open_count() > 0 and force_exit_now():
                for pos in list(broker.open_positions()):
                    price = last_ltp_by_symbol.get(pos.symbol)
                    if price is None:
                        continue

                    closed_pos = broker.close(pos.symbol, now_ist(), price, reason="FORCED_EOD")
                    if closed_pos:
                        print(f"🛑 FORCED EOD EXIT ({closed_pos.side}) {closed_pos.symbol} @ {closed_pos.exit_price:.2f}")
                        record_exit_and_print(closed_pos, risk, reporter)
                        session_result["trade_closed"] = True
                        session_result["closed_symbols"].append(closed_pos.symbol)

                session_result["session_reason"] = "FORCED_EOD"
                ws.close()
                return

            triggered_candidates = []

            for inst_key, feed in resp.feeds.items():
                if inst_key not in by_key or not feed.HasField("ltpc"):
                    continue

                info = by_key[inst_key]
                symbol = info["symbol"]
                ltpc = feed.ltpc
                ltp = float(ltpc.ltp)
                tick_ts = ms_to_dt_local(int(ltpc.ltt))
                last_ltp_by_symbol[symbol] = ltp

                closed_tick = broker.check_exits(symbol, tick_ts, ltp, is_candle_close=False)
                if closed_tick:
                    record_exit_and_print(closed_tick, risk, reporter)
                    session_result["trade_closed"] = True
                    session_result["closed_symbols"].append(symbol)
                    continue

                if info["disabled"]:
                    continue

                candle = info["builder"].update(tick_ts, ltp)
                if not candle:
                    continue

                info["recent_low"] = candle.low if info["recent_low"] is None else min(info["recent_low"], candle.low)
                info["recent_highs"].append(candle.high)
                info["recent_lows"].append(candle.low)
                if len(info["recent_highs"]) > 15:
                    info["recent_highs"] = info["recent_highs"][-15:]
                if len(info["recent_lows"]) > 15:
                    info["recent_lows"] = info["recent_lows"][-15:]

                print(
                    f"🕯 {TIMEFRAME_MINUTES}m {symbol} {candle.ts} "
                    f"O={candle.open:.2f} H={candle.high:.2f} "
                    f"L={candle.low:.2f} C={candle.close:.2f}"
                )

                closed_candle = broker.check_exits(symbol, candle.ts, candle.close, is_candle_close=True)
                if closed_candle:
                    record_exit_and_print(closed_candle, risk, reporter)
                    session_result["trade_closed"] = True
                    session_result["closed_symbols"].append(symbol)
                    continue

                if broker.open_count() >= MAX_PARALLEL_TRADES:
                    info["prev_candle"] = candle
                    continue

                if broker.has_open_position(symbol):
                    info["prev_candle"] = candle
                    continue

                info["focus_candle_count"] += 1
                if info["focus_candle_count"] >= MAX_FOCUS_CANDLES:
                    info["disabled"] = True
                    print(f"⏱ {symbol} focus window exhausted. Disabling until next rescan.")
                    info["prev_candle"] = candle
                    continue

                if in_early_skip_window_ist():
                    print(f"⏳ Skipping early-market candles (first {SKIP_FIRST_MINUTES} min IST).")
                    info["prev_candle"] = candle
                    continue

                if no_new_entries_now():
                    info["prev_candle"] = candle
                    continue

                sig = info["strat"].on_candle_close(candle)
                fast = info["strat"].fast.value or 0.0
                slow = info["strat"].slow.value or 0.0

                print(f"📈 {symbol} Signal: {sig.action} ({sig.reason}) fast={fast:.2f} slow={slow:.2f}")

                ok, reason = risk.can_trade(trading_day())
                if not ok:
                    print(f"⛔ Blocked by risk: {reason}")
                    reporter.info("blocked_by_risk", {"reason": reason})
                    info["prev_candle"] = candle
                    continue

                if info["bias"] == "LONG" and sig.action != "BUY":
                    info["prev_candle"] = candle
                    continue

                if info["bias"] == "SHORT" and sig.action != "SELL":
                    info["prev_candle"] = candle
                    continue

                entry_type = entry_type_for_signal(info["prev_candle"], candle, info["bias"], fast, slow, cfg)
                if not entry_type:
                    reporter.info("entry_skip", {"symbol": symbol, "reason": "breakout_or_ema_not_ready"})
                    info["prev_candle"] = candle
                    continue

                if abs(fast - slow) < candle.close * cfg["ema_gap_pct"]:
                    print(f"🧊 {symbol} weak trend (EMA gap too small). Skipping entry.")
                    reporter.info("entry_skip", {"symbol": symbol, "reason": "ema_gap_too_small"})
                    info["prev_candle"] = candle
                    continue

                if info["bias"] == "SHORT":
                    if market_trend == "BULLISH":
                        print(f"🚫 {symbol} short blocked by bullish market trend.")
                        reporter.info("entry_skip", {"symbol": symbol, "reason": "bullish_market_blocks_short"})
                        info["prev_candle"] = candle
                        continue

                    if info["recent_low"] and candle.close > info["recent_low"] * (1 + SHORT_RECENT_BOUNCE_PCT):
                        print(f"🚫 {symbol} short blocked by bounce from recent low.")
                        reporter.info("entry_skip", {"symbol": symbol, "reason": "recent_bounce_blocks_short"})
                        info["prev_candle"] = candle
                        continue

                if info["bias"] == "LONG" and market_trend == "BEARISH":
                    print(f"🚫 {symbol} long blocked by bearish market trend.")
                    reporter.info("entry_skip", {"symbol": symbol, "reason": "bearish_market_blocks_long"})
                    info["prev_candle"] = candle
                    continue

                if entry_type == "CONFIRMED":
                    if not is_strong_entry_candle(info["prev_candle"], candle, info["bias"], cfg["entry_body_ratio_min"]):
                        print(f"🚫 {symbol} weak breakout candle. Skipping entry.")
                        reporter.info("entry_skip", {"symbol": symbol, "reason": "weak_breakout_candle"})
                        info["prev_candle"] = candle
                        continue

                chase_pct = breakout_chase_pct(info["prev_candle"], candle, info["bias"])
                if chase_pct > cfg["max_breakout_chase_pct"]:
                    print(f"🚫 {symbol} late entry avoided. Chase={chase_pct * 100:.2f}%")
                    reporter.info("entry_skip", {"symbol": symbol, "reason": "late_entry_chase", "chase_pct": chase_pct})
                    info["prev_candle"] = candle
                    continue

                if too_close_to_recent_extreme(info, candle, info["bias"], cfg["recent_extreme_pct"]):
                    print(f"🚫 {symbol} too close to recent extreme. Skipping entry.")
                    reporter.info("entry_skip", {"symbol": symbol, "reason": "too_close_to_recent_extreme"})
                    info["prev_candle"] = candle
                    continue

                if abs(info["pct"]) > MAX_ENTRY_MOVE_PCT:
                    print(f"🚫 {symbol} skipped: too extended at entry ({info['pct']:.2f}%).")
                    reporter.info("entry_skip", {"symbol": symbol, "reason": "too_extended_at_scan", "pct": info["pct"]})
                    info["prev_candle"] = candle
                    continue

                confidence = confidence_score(info, candle, fast, slow, entry_type)
                if confidence < cfg["confidence_threshold"]:
                    print(f"🚫 {symbol} confidence too low ({confidence:.2f}).")
                    reporter.info("entry_skip", {"symbol": symbol, "reason": "low_confidence", "confidence": confidence})
                    info["prev_candle"] = candle
                    continue

                triggered_candidates.append(
                    {
                        "inst_key": inst_key,
                        "symbol": symbol,
                        "bias": info["bias"],
                        "score": info["score"],
                        "candle": candle,
                        "max_shares": info["max_shares"],
                        "pct": info["pct"],
                        "vol": info["vol"],
                        "entry_type": entry_type,
                        "confidence": confidence,
                    }
                )
                info["prev_candle"] = candle

            if triggered_candidates and broker.open_count() < MAX_PARALLEL_TRADES:
                triggered_candidates.sort(
                    key=lambda x: (x["confidence"], x["score"], abs(x["pct"]), x["vol"]),
                    reverse=True,
                )

                slots_available = MAX_PARALLEL_TRADES - broker.open_count()

                for chosen in triggered_candidates[:slots_available]:
                    symbol = chosen["symbol"]

                    if broker.has_open_position(symbol):
                        continue

                    candle = chosen["candle"]
                    stop_rupees = candle.close * STOP_LOSS_PCT
                    if stop_rupees <= 0:
                        continue

                    base_qty = max(
                        1,
                        min(
                            int(risk.position_risk_amount() // stop_rupees) or 1,
                            int(CAPITAL_PER_TRADE // candle.close),
                            chosen["max_shares"],
                        ),
                    )

                    qty = max(
                        1,
                        min(
                            int(base_qty * size_multiplier(chosen["confidence"], regime)),
                            int(CAPITAL_PER_TRADE // candle.close),
                            chosen["max_shares"],
                        ),
                    )

                    sl = candle.close - stop_rupees if chosen["bias"] == "LONG" else candle.close + stop_rupees

                    if chosen["entry_type"] == "EARLY":
                        trailing_start = cfg["trailing_start_pct_early"]
                        trailing_buffer = cfg["trailing_buffer_pct_early"]
                    else:
                        trailing_start = cfg["trailing_start_pct_confirmed"]
                        trailing_buffer = cfg["trailing_buffer_pct_confirmed"]

                    if chosen["bias"] == "LONG":
                        broker.open_long(
                            symbol,
                            candle.ts,
                            candle.close,
                            qty,
                            sl,
                            take_profit=None,
                            profit_lock_mode="trailing",
                            profit_trailing_start_pct=trailing_start,
                            profit_trailing_buffer_pct=trailing_buffer,
                        )
                        print(
                            f"📝 PAPER BUY {symbol} qty={qty} entry={candle.close:.2f} "
                            f"SL={sl:.2f} type={chosen['entry_type']} conf={chosen['confidence']:.2f} "
                            f"trail_start={trailing_start * 100:.2f}% buffer={trailing_buffer * 100:.2f}%"
                        )
                    else:
                        broker.open_short(
                            symbol,
                            candle.ts,
                            candle.close,
                            qty,
                            sl,
                            take_profit=None,
                            profit_lock_mode="trailing",
                            profit_trailing_start_pct=trailing_start,
                            profit_trailing_buffer_pct=trailing_buffer,
                        )
                        print(
                            f"📝 PAPER SHORT {symbol} qty={qty} entry={candle.close:.2f} "
                            f"SL={sl:.2f} type={chosen['entry_type']} conf={chosen['confidence']:.2f} "
                            f"trail_start={trailing_start * 100:.2f}% buffer={trailing_buffer * 100:.2f}%"
                        )

                    risk.record_trade_opened(trading_day())

                    reporter.record_entry(
                        symbol,
                        chosen["bias"],
                        qty,
                        float(candle.close),
                        float(sl),
                        float(trailing_start),
                    )

                    reporter.info(
                        "entry_details",
                        {
                            "side": chosen["bias"],
                            "entry_type": chosen["entry_type"],
                            "confidence": round(chosen["confidence"], 4),
                            "exit_model": "TRAILING_PARALLEL",
                            "regime": regime,
                            "selected_from_topk": [by_key[k]["symbol"] for k in instrument_keys],
                            "breakout_confirmation": chosen["entry_type"] == "CONFIRMED",
                            "entry_body_ratio_min": cfg["entry_body_ratio_min"],
                            "max_breakout_chase_pct": cfg["max_breakout_chase_pct"],
                            "min_dist_from_recent_extreme_pct": cfg["recent_extreme_pct"],
                            "market_trend": market_trend,
                            "smart_short_filter": True,
                            "trailing_start_pct": trailing_start,
                            "trailing_buffer_pct": trailing_buffer,
                            "capital_per_trade": CAPITAL_PER_TRADE,
                            "max_parallel_trades": MAX_PARALLEL_TRADES,
                        },
                    )

                    session_result["trade_opened"] = True

            if broker.open_count() == 0 and all(info["disabled"] for info in by_key.values()):
                print("🔁 All monitored symbols exhausted focus window. Returning to scan mode.")
                session_result["session_reason"] = "TOPK_EXHAUSTED"
                ws.close()
                return

        def on_error(ws, error):
            print("❌ WebSocket error:", error)
            reporter.error("websocket_error", {"error": str(error)})

        def on_close(ws, code, reason):
            print("🔌 WebSocket closed:", code, reason)
            reporter.info("websocket_closed", {"code": code, "reason": str(reason)})

        try:
            print(f"✅ Connecting WebSocket for top-{TOP_K_MONITOR} parallel monitoring")
            ws = websocket.WebSocketApp(
                ws_url,
                on_open=on_open,
                on_message=on_message,
                on_error=on_error,
                on_close=on_close,
            )

            ws.run_forever(
                ping_interval=WS_PING_INTERVAL,
                ping_timeout=WS_PING_TIMEOUT,
                sslopt={"cert_reqs": ssl.CERT_REQUIRED, "ca_certs": certifi.where()},
            )

            if session_result["trade_closed"] or session_result["session_reason"] in {
                "TOPK_EXHAUSTED",
                "ENTRY_CUTOFF",
                "FORCED_EOD",
                "MARKET_CLOSE",
                "PERIODIC_RESCAN",
                "RISK_BLOCK_max-trades-hit",
            }:
                return session_result

            if market_stopped():
                session_result["stop_requested"] = True
                session_result["session_reason"] = "MARKET_CLOSE"
                return session_result

            retries += 1
            print(f"🔁 Reconnecting top-k session in {WS_RECONNECT_DELAY_SEC} seconds... (retry {retries}/{WS_MAX_RETRIES_PER_SESSION})")
            reporter.info("reconnecting_topk_session", {"retry": retries})
            time_mod.sleep(WS_RECONNECT_DELAY_SEC)

        except KeyboardInterrupt:
            session_result["stop_requested"] = True
            session_result["session_reason"] = "STOPPED_BY_USER"
            return session_result

        except Exception as e:
            retries += 1
            print("❌ Top-k session error:", e)
            reporter.error("topk_session_error", {"error": str(e), "retry": retries})
            time_mod.sleep(WS_RECONNECT_DELAY_SEC)

    session_result["session_reason"] = "TOPK_RETRY_EXHAUSTED"
    return session_result


def main():
    print("🚀 Starting NIFTY200 TOP-10 trailing bot v2 PARALLEL...")
    token = load_token()
    print("✅ Token loaded")
    sym_to_key = load_watchlist_symbol_to_key()
    print(f"✅ Watchlist loaded: {len(sym_to_key)} symbols")

    reporter = TradeReporter(
        json_path="web/data/dashboard_n200_top10_trailing_parallel.json",
        csv_dir="logs_n200_top10_trailing_parallel",
        capital=TOTAL_CAPITAL,
        mode="PAPER_TOP10_V2_PARALLEL",
    )
    print("✅ Reporter initialized")

    risk = RiskManager(
        RiskConfig(
            capital=CAPITAL_PER_TRADE,
            risk_per_trade_pct=RISK_PER_TRADE_PCT,
            max_daily_loss_pct=MAX_DAILY_LOSS_PCT,
            max_trades_per_day=MAX_TRADES_PER_DAY,
        )
    )

    broker = PaperBroker()
    cooldown_until: Dict[str, datetime] = {}
    choppy_streak = 0

    while True:
        if market_stopped():
            print("🏁 Market close reached. Bot stopping.")
            reporter.info("stop_bot_market_close", {"time_ist": str(ist_time_now())})
            break

        if no_new_entries_now() and broker.open_count() == 0:
            print("⏳ Entry cutoff reached. Waiting for market close.")
            reporter.info("entry_cutoff_waiting", {"time_ist": str(ist_time_now())})
            while not market_stopped():
                time_mod.sleep(30)
            print("🏁 Market close reached. Bot stopping.")
            reporter.info("stop_bot_market_close", {"time_ist": str(ist_time_now())})
            break

        token = load_token()
        snapshot = get_market_snapshot(token)
        market_trend = snapshot["trend"]
        regime = snapshot["regime"]
        index_pct = snapshot["pct"]
        cfg = settings_for_regime(regime)

        print(f"🌡 Market snapshot: trend={market_trend} regime={regime} index_move={index_pct * 100:.2f}%")

        try:
            top_candidates = pick_top_candidates_bi_directional(
                token=token,
                sym_to_key=sym_to_key,
                cooldown_until=cooldown_until,
                market_trend=market_trend,
                cfg=cfg,
                top_k=TOP_K_MONITOR,
            )

        except Exception as e:
            print("⚠️ Scan failed:", e)
            reporter.error("scan_failed", {"error": str(e)})
            time_mod.sleep(SCAN_INTERVAL_SEC)
            continue

        print(f"✅ Candidates found: {len(top_candidates)}")

        if not top_candidates:
            choppy_streak += 1
            print("⚠️ No suitable candidates found. Waiting for next scan...")
            reporter.info(
                "no_candidates_found",
                {
                    "reason": "filters_not_matched",
                    "choppy_streak": choppy_streak,
                    "market_trend": market_trend,
                    "regime": regime,
                },
            )

            if regime == "CHOPPY" and choppy_streak >= CHOPPY_STREAK_THRESHOLD:
                print(f"🧘 Choppy market detected. Pausing for {CHOPPY_PAUSE_MIN} minutes.")
                reporter.info("choppy_pause", {"minutes": CHOPPY_PAUSE_MIN})
                time_mod.sleep(CHOPPY_PAUSE_MIN * 60)
            else:
                time_mod.sleep(SCAN_INTERVAL_SEC)

            continue

        first = top_candidates[0]

        shortlist = [
            {
                "symbol": sym,
                "bias": bias,
                "ltp": round(ltp, 2),
                "pct": round(pct, 2),
                "vol": int(vol),
                "score": round(float(score), 2),
                "max_shares": int(max_shares),
            }
            for score, sym, inst_key, bias, ltp, max_shares, pct, vol in top_candidates
        ]

        reporter.set_selected(
            first[1],
            first[2],
            extras={
                "bias": first[3],
                "ltp": round(first[4], 2),
                "pct": round(first[6], 2),
                "vol": int(first[7]),
                "max_shares": int(first[5]),
                "score": round(float(first[0]), 2),
                "watchlist": "nifty200_watchlist",
                "mode": "SCAN_THEN_TRADE_TOP10_V2_PARALLEL",
                "scan_interval_sec": SCAN_INTERVAL_SEC,
                "max_focus_candles": MAX_FOCUS_CANDLES,
                "rescan_interval_min": RESCAN_INTERVAL_MIN,
                "ema_gap_pct": cfg["ema_gap_pct"],
                "stop_loss_pct": STOP_LOSS_PCT,
                "top_k_monitor": TOP_K_MONITOR,
                "symbol_cooldown_min": SYMBOL_COOLDOWN_MIN,
                "market_trend": market_trend,
                "market_regime": regime,
                "market_index_move_pct": round(index_pct * 100, 2),
                "entry_body_ratio_min": cfg["entry_body_ratio_min"],
                "max_breakout_chase_pct": cfg["max_breakout_chase_pct"],
                "min_dist_from_recent_extreme_pct": cfg["recent_extreme_pct"],
                "confidence_threshold": cfg["confidence_threshold"],
                "max_parallel_trades": MAX_PARALLEL_TRADES,
                "capital_per_trade": CAPITAL_PER_TRADE,
                "total_capital": TOTAL_CAPITAL,
                "no_new_entries_after_ist": str(NO_NEW_ENTRIES_AFTER_IST),
                "shortlist": shortlist,
            },
        )

        result = run_topk_session(
            token=token,
            candidates=top_candidates,
            risk=risk,
            broker=broker,
            reporter=reporter,
            market_trend=market_trend,
            regime=regime,
            cfg=cfg,
        )

        if result["stop_requested"]:
            print("🛑 Stopping bot.")
            break

        for sym in result.get("closed_symbols", []):
            cooldown_until[sym] = now_ist() + timedelta(minutes=SYMBOL_COOLDOWN_MIN)

        print(f"🔄 Returning to SCAN mode. reason={result['session_reason']}")
        reporter.info("return_to_scan_mode", {"reason": result["session_reason"], "regime": regime})

        if result["session_reason"] in {"TOPK_EXHAUSTED", "TOPK_RETRY_EXHAUSTED"}:
            choppy_streak += 1
        else:
            choppy_streak = 0

        if regime == "CHOPPY" and choppy_streak >= CHOPPY_STREAK_THRESHOLD:
            print(f"🧘 Consecutive choppy cycles detected. Pausing for {CHOPPY_PAUSE_MIN} minutes.")
            reporter.info("choppy_pause", {"minutes": CHOPPY_PAUSE_MIN, "reason": result["session_reason"]})
            time_mod.sleep(CHOPPY_PAUSE_MIN * 60)
        else:
            time_mod.sleep(SCAN_INTERVAL_SEC)


if __name__ == "__main__":
    main()
